NEXT_PUBLIC_API_URL=http://localhost:3001

# 카카오 로컬 API(주소 검색) REST 키 — Kakao Developers 앱의 REST API 키, 서버에서만 사용
KAKAO_REST_API_KEY=

# OAuth 소셜 로그인 — provider 콘솔에 등록한 Client ID/redirect URI (client_secret은 BE 전용, FE엔 안 둠)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback

NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/oauth/naver/callback

# 카카오톡 공유(JS SDK) JavaScript 키 — 브라우저에서 쓰므로 NEXT_PUBLIC_ 필요.
# Kakao Developers 앱 > 앱 키 > JavaScript 키.
#
# ⚠️ 카카오 키가 셋이라 헷갈리기 쉽습니다 — 셋 다 같은 앱의 다른 키입니다.
#   KAKAO_REST_API_KEY           REST API 키    주소 검색(서버 전용)
#   NEXT_PUBLIC_KAKAO_CLIENT_ID  REST API 키    OAuth 로그인
#   NEXT_PUBLIC_KAKAO_JS_KEY     JavaScript 키  공유  ← 이것만 종류가 다름
#
# 키만으로는 동작하지 않습니다. 콘솔에서 도메인을 두 군데 등록해야 합니다.
#   1) [앱 설정 > 플랫폼 > Web] 사이트 도메인      — Kakao.init() 허용
#   2) [앱 > 제품 링크 관리 > 웹 도메인]            — 공유 요청 허용
# 2번이 빠지면 공유 창에서 4019(인증 실패)가 납니다. 로컬은 http://localhost:3000.
# 앱 소유자만 설정할 수 있으니 본인 앱이 아니면 소유자에게 요청하세요.
# 키가 없으면 카카오 버튼은 링크 복사로 폴백합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
