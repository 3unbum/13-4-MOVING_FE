# 백엔드 주소. next.config.ts의 rewrites(/api/*)와 서버 컴포넌트가 함께 씁니다.
#   로컬  http://localhost:3001
#   배포  https://<백엔드 도메인>   (Vercel 환경 변수에 설정)
# 끝에 슬래시를 붙이지 마세요 — `${...}/api/:path*` 로 이어 붙입니다.
#
# ⚠️ 배포 주소는 반드시 HTTPS여야 합니다.
# `lib/auth/find-my-account.ts` 가 세션 쿠키를 `Cookie` 헤더로 실어 보내는데,
# http면 Vercel↔백엔드 구간에서 평문으로 전달됩니다.
# 심화 요구사항("HTTPS를 적용합니다")에도 해당하는 항목입니다.
# 현재는 EC2 IP(http)로 붙어 있고, 도메인 연결 후 https로 전환 예정입니다.
NEXT_PUBLIC_API_URL=http://localhost:3001
# 프로필 이미지가 올라가는 S3 버킷 호스트네임 (예: my-bucket.s3.ap-northeast-2.amazonaws.com)
# next.config.ts의 images.remotePatterns에 씀 — 없으면 next/image가 프로필 이미지를 못 불러옵니다.
NEXT_PUBLIC_S3_IMAGE_HOST=

# 카카오 로컬 API(주소 검색) REST 키 — Kakao Developers 앱의 REST API 키, 서버에서만 사용
KAKAO_REST_API_KEY=

# OAuth 소셜 로그인 — provider 콘솔에 등록한 Client ID/redirect URI (client_secret은 BE 전용, FE엔 안 둠)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback

NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/oauth/naver/callback

# 카카오톡 공유(JS SDK) JavaScript 키 — 브라우저에서 쓰므로 NEXT_PUBLIC_ 필요.
# Kakao Developers 앱 > 앱 키 > JavaScript 키.
#
# ⚠️ 카카오 키가 셋이라 헷갈리기 쉽습니다 — 셋 다 같은 앱의 다른 키입니다.
#   KAKAO_REST_API_KEY           REST API 키    주소 검색(서버 전용)
#   NEXT_PUBLIC_KAKAO_CLIENT_ID  REST API 키    OAuth 로그인
#   NEXT_PUBLIC_KAKAO_JS_KEY     JavaScript 키  공유  ← 이것만 종류가 다름
#
# 키만으로는 동작하지 않습니다. 콘솔에서 도메인을 두 군데 등록해야 합니다.
#   1) [앱 설정 > 플랫폼 > Web] 사이트 도메인      — Kakao.init() 허용
#   2) [앱 > 제품 링크 관리 > 웹 도메인]            — 공유 요청 허용
# 2번이 빠지면 공유 창에서 4019(인증 실패)가 납니다. 로컬은 http://localhost:3000.
# 앱 소유자만 설정할 수 있으니 본인 앱이 아니면 소유자에게 요청하세요.
# 키가 없으면 카카오 버튼은 링크 복사로 폴백합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Sentry 에러 모니터링 (선택). 비워두면 Sentry가 비활성화됩니다.
# 배포 환경에만 Vercel 환경변수로 주입합니다.
#
# 환경 구분(production/preview)은 Vercel이 자동 주입하는 `NEXT_PUBLIC_VERCEL_ENV`를 씁니다.
# 직접 넣을 필요 없고, 로컬에서는 없으므로 NODE_ENV(development)로 떨어집니다.
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile 사이트 키 (선택, 공개 값). 비우면 로그인 봇 검증 위젯이 안 뜹니다.
# BE의 TURNSTILE_SECRET_KEY와 짝입니다. 로컬 테스트용 항상-통과 키: 1x00000000000000000000AA
# 값을 바꾸면 Vercel은 재배포해야 반영됩니다 (빌드 시점에 박힘).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
